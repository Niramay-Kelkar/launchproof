# LaunchProof backend environment (copy to .env, fill in before using real adapters)
DATABASE_URL=sqlite:///./launchproof.db

# If real_research() fails every fetch with "SSLCertVerificationError" and
# `python -c "import ssl; print(ssl.create_default_context().cert_store_stats())"`
# shows x509_ca: 0, your local Python has no trusted root CAs loaded -- a
# known issue with the python.org macOS installer (not a bug in
# research_adapter.py or network.py). See README.md's "Local TLS trust
# store" section for the one-line fix; this is a *local environment*
# setting, not something the app reads from .env automatically.
# export SSL_CERT_FILE=$(python -c "import certifi; print(certifi.where())")

# Research adapter: leave blank to use the labeled fixture adapter
RESEARCH_PROVIDER_API_KEY=

# Set true only when a real sponsor call has been smoke-tested and verified
RESEARCH_PROVIDER_IS_REAL=false

# ---- Glasser (https://glasser.ai) -- the one real sponsor integration ----
# Only consulted when RESEARCH_PROVIDER_IS_REAL=true. When GLASSER_ENABLED is
# false (the default) or GLASSER_API_KEY is blank, research_adapter.py skips
# Glasser entirely and falls back to founder-pasted URLs only -- it never
# falls back to fixture/mock evidence on its own. See README.md for details.
GLASSER_ENABLED=false
GLASSER_API_KEY=

# Optional: per-call HTTP timeout to Glasser's API, in seconds.
GLASSER_HTTP_TIMEOUT_SECONDS=10

# ---- Masky.AI integration (POST/GET /api/runs) ----
# All three of MASKY_API_KEY, MASKY_AVATAR_ID and MASKY_AVATAR_OWNER_USER_ID
# must be set to enable RealMaskyProvider -- leaving any one blank keeps
# masky_adapter.py on the explicitly-labeled mock provider (default).
# RealMaskyProvider's request/response contract has been verified against
# masky.ai/api/docs (POST /conversations, POST /conversations/{id}/turn,
# text-output only -- no audio/video), but it has NOT yet been exercised
# against the live API. See backend/README.md.
MASKY_API_KEY=
MASKY_AVATAR_ID=
# Required by the documented POST /conversations contract. Get this by
# calling GET /avatars with your MASKY_API_KEY and reading the
# avatarOwnerUserId field off the avatar you want Avery to use (you own it,
# so this is your own account identifier, e.g. "twitch:12345"). Never
# guessed or defaulted by this app.
MASKY_AVATAR_OWNER_USER_ID=
MASKY_API_BASE_URL=https://masky.ai/api

# The public HTTPS URL this backend is reachable at, for you to hand to
# Masky's configuration -- not read by the app itself; documentation only.
PUBLIC_API_URL=
